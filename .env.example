# Copy to .env.local for local dev. On Vercel, add these under Project > Settings > Environment Variables.
# NEVER prefix these with NEXT_PUBLIC_ and never commit the real values.

GEMINI_API_KEY=your-key-from-aistudio.google.com/apikey
ACCESS_CODE=pick-a-passcode-to-share-with-friends

# Optional
RATE_LIMIT_PER_DAY=10
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
